# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running locally.
# On Railway, set these as environment variables in the service dashboard.
# ──────────────────────────────────────────────────────────────────────────────

# Required — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Set to False in production (default is already False)
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
# Default: banco-web.railway.app,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=banco-web.railway.app,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include scheme)
# Default: https://banco-web.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://banco-web.railway.app

# Set to False if your Railway service sits behind a proxy that already handles
# SSL termination and you do NOT want Django to issue its own redirect.
# Default: True when DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL connection string (Railway provides this automatically when you
# attach a Postgres plugin; Neon and other providers also use this format)
# Leave unset to fall back to the local SQLite database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: override the writable directory used for user-uploaded files.
# Defaults to <project_root>/media locally, or /tmp/media on Render.
# MEDIA_ROOT=/tmp/media

# ── Encryption ────────────────────────────────────────────────────────────────
# Fernet key used to encrypt sensitive document fields.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-real-fernet-key

# ── Email ─────────────────────────────────────────────────────────────────────
# Use the console backend locally; switch to smtp for production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@bancovalidacion.com
